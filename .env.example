# Copy to .env and fill in — never commit the real .env
ENVIRONMENT=production       # or: development (enables local LAN wildcard CORS for mobile testing)
FRONTEND_URL=                # e.g. https://wageguard.onrender.com or https://wageguard-india.vercel.app
ALLOWED_ORIGINS=             # optional comma-separated list of additional allowed origins
TRUSTED_PROXIES=             # optional comma-separated list of reverse proxy IPs/CIDRs (e.g. 10.0.0.0/8,127.0.0.1)

LLM_PROVIDER=gemini          # or: openai / anthropic
LLM_API_KEY=
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
CHROMA_PERSIST_DIR=./rag_store/index
VITE_API_BASE_URL=http://localhost:8000

